{
  "description": "Format Terraform files with terraform fmt after Claude edits them",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/terraform-fmt.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
